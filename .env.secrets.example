# ------------------------------------------------------------------
# PostgreSQL container credentials (used by docker-compose postgres)
# ------------------------------------------------------------------
POSTGRES_USER=lotty
POSTGRES_PASSWORD=lotty
POSTGRES_DB=lotty
POSTGRES_PORT=5433

# ------------------------------------------------------------------
# Application database connection (used by make run / app startup)
# Keep DB_DSN in sync with credentials above.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
DB_DSN=postgres://lotty:lotty@localhost:5433/lotty?sslmode=disable

# ------------------------------------------------------------------
# Application runtime settings
# APP_PORT: HTTP listen port
# LOG_LEVEL: debug | info | warn | error
# GUARDRAIL_TICK_SECONDS: how often guardrail evaluator runs
# GUARDRAIL_WORKER_ENABLED: true enables event-driven worker (false = legacy polling)
# GUARDRAIL_WORKER_BATCH_SIZE: max claimed jobs per worker iteration
# GUARDRAIL_WORKER_POLL_MS: queue polling interval in milliseconds
# GUARDRAIL_FALLBACK_SCAN_SECONDS: low-frequency full-scan fallback interval
# GUARDRAIL_LEADER_LOCK_KEY: lease row key for single active worker semantics
# GUARDRAIL_LEADER_TTL_SECONDS: lease ttl for leader heartbeat/renewal
# ------------------------------------------------------------------
APP_PORT=8080
LOG_LEVEL=info
GUARDRAIL_TICK_SECONDS=10
GUARDRAIL_WORKER_ENABLED=true
GUARDRAIL_WORKER_BATCH_SIZE=50
GUARDRAIL_WORKER_POLL_MS=1000
GUARDRAIL_FALLBACK_SCAN_SECONDS=300
GUARDRAIL_LEADER_LOCK_KEY=guardrail_worker
GUARDRAIL_LEADER_TTL_SECONDS=15
